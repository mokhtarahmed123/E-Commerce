@model E_Commerce.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="add-category-container d-flex justify-content-center align-items-center">
    <div class="add-category-card shadow-lg rounded-4">
        <div class="text-center mb-4">
            <div class="category-icon mb-3">
                <i class="bi bi-tags-fill"></i>
            </div>
            <h3 class="fw-bold">Add New Category</h3>
            <p class="text-muted">Organize your products with categories</p>
        </div>

        <form asp-action="SaveAdd">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- Category Name -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-pencil-fill"></i></span>
                    <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                </div>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-grid">
                <button type="submit" class="btn btn-gradient fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Create Category
                </button>
            </div>
        </form>

        <div class="text-center mt-4">
            <a asp-action="AllCategory" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
