@model List<Product>

@{
    ViewData["Title"] = "Home";
}
<partial name="_PartialHeader"></partial>

<section class="py-5 bg-light">
    <div class="container px-4 px-lg-5 mt-5">
        <div class="text-center mb-5">
            <h1 class="fw-bold display-5 text-gradient">
                <i class="bi bi-bag-heart-fill"></i> Featured Products
            </h1>
            <p class="text-muted fs-5">Discover our top products — handpicked just for you!</p>
        </div>

        <div class="row gx-4 gx-lg-5 row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 justify-content-center">
            @foreach (var item in Model.OrderBy(x => Guid.NewGuid()).Take(6))
            {
                <div class="col mb-5">
                    <div class="card product-card h-100 shadow-lg border-0 rounded-4">
                        <!-- Product Image -->
                        <div class="image-container">
                            <img class="card-img-top img-fluid rounded-top"
                                 src="~/Image/@Url.Content(item.UrlImage)"
                                 alt="@item.Name" />
                            <div class="overlay">
                                <a class="btn btn-light btn-sm shadow-sm" asp-route-id="@item.Id" asp-action="CreateOrder" asp-controller="OrderDetail">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </a>
                            </div>
                        </div>

                        <!-- Product Details -->
                        <div class="card-body p-4 text-center">
                            <h5 class="fw-bold text-dark">@item.Name</h5>
                            <p class="price-tag mb-1">$@item.Price</p>
                            <span class="badge bg-secondary px-3 py-2">Stock: @item.Quantity</span>
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer p-3 border-top-0 bg-transparent text-center">
                            <a class="btn btn-gradient w-100" asp-route-id="@item.Id" asp-action="CreateOrder" asp-controller="OrderDetail">
                                <i class="bi bi-bag-plus-fill"></i> Add to Cart
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<partial name="_PartialFooter"></partial>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
