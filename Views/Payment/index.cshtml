@model List<E_Commerce.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<partial name="_PartialHeader"></partial>

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 payment-card">
        <div class="card-header bg-gradient-primary text-white text-center py-3 rounded-top">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-credit-card-2-front-fill"></i> Payment History
            </h2>
            <p class="mb-0 text-light">Track all your completed payments easily</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="bi bi-box-seam"></i> Product</th>
                            <th><i class="bi bi-wallet2"></i> Payment Method</th>
                            <th><i class="bi bi-cash-stack"></i> Total Price (EGP)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@p.Order?.Product?.Name</td>
                                <td>
                                    @if (p.PaymentMethod == "Cash")
                                    {
                                        <span class="badge bg-success px-3 py-2 shadow-sm">
                                            <i class="bi bi-cash"></i> Cash
                                        </span>
                                    }
                                    else if (p.PaymentMethod == "Card")
                                    {
                                        <span class="badge bg-primary px-3 py-2 shadow-sm">
                                            <i class="bi bi-credit-card"></i> Card
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 shadow-sm">
                                            <i class="bi bi-wallet"></i> @p.PaymentMethod
                                        </span>
                                    }
                                </td>
                                <td class="fw-bold text-primary">@p.Order?.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center mb-0 rounded-0 py-4 fs-5 shadow-sm">
                <i class="bi bi-info-circle-fill"></i> No payments found.
            </div>
        }
    </div>
</div>

<partial name="_PartialFooter"></partial>
