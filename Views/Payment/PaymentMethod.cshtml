@model E_Commerce.ViewModel.PaymentWIthOrderVM

@{
    ViewData["Title"] = "Payment Method";
}

<partial name="_PartialHeader"></partial>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-4 border-0 payment-card">
                <div class="card-header bg-gradient-primary text-white text-center rounded-top py-3">
                    <h3 class="fw-bold mb-0">
                        <i class="bi bi-credit-card-fill"></i> Payment Method
                    </h3>
                    <p class="mb-0 text-light fs-6">Secure & Fast Payment</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="SavePaymentMethod" asp-controller="Payment" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger mb-3 shadow-sm"></div>

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-box-seam-fill text-primary"></i> Product Name
                            </label>
                            <input type="text" class="form-control form-control-lg shadow-sm" value="@Model.ProductName" readonly />
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-3">
                            <label asp-for="PaymentMethod" class="form-label fw-semibold">
                                <i class="bi bi-wallet2 text-success"></i> Select Payment Method
                            </label>
                            <select asp-for="PaymentMethod" class="form-select form-select-lg shadow-sm">
                                <option value="">-- Select --</option>
                                <option value="Cash">💵 Cash</option>
                                <option value="Visa">💳 Visa</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        <!-- Quantity -->
                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-semibold">
                                <i class="bi bi-cart4 text-warning"></i> Quantity
                            </label>
                            <input asp-for="Quantity" class="form-control form-control-lg shadow-sm" readonly />
                        </div>

                        <!-- Total Price -->
                        <div class="mb-3">
                            <label asp-for="TotalPrice" class="form-label fw-semibold">
                                <i class="bi bi-cash-stack text-success"></i> Total Price
                            </label>
                            <input asp-for="TotalPrice" class="form-control form-control-lg shadow-sm" readonly />
                        </div>

                        <!-- Hidden Inputs -->
                        <input type="hidden" asp-for="OrderId" />
                        <input type="hidden" asp-for="PaymentId" />

                        <!-- Confirm Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-gradient fw-bold shadow">
                                <i class="bi bi-check-circle-fill"></i> Confirm Payment
                            </button>
                            <a asp-action="Index" asp-controller="OrderDetail" class="btn btn-outline-dark fw-semibold shadow-sm">
                                <i class="bi bi-arrow-left-circle"></i> Back to Orders
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_PartialFooter"></partial>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
