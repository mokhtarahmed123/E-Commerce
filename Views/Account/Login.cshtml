@model E_Commerce.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-container d-flex justify-content-center align-items-center">
    <div class="login-card shadow-lg rounded-4">
        <div class="text-center mb-4">
            <img src="~/images/logo.png" alt="Logo" class="login-logo">
            <h3 class="fw-bold mt-3">Welcome Back 👋</h3>
            <p class="text-muted">Please login to your account</p>
        </div>

        <form asp-action="LoginCheck" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Username -->
            <div class="form-group mb-3">
                <label asp-for="UserName" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-person-fill"></i></span>
                    <input asp-for="UserName" class="form-control" placeholder="Enter your username" />
                </div>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="Enter your password" type="password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-4">
                <input class="form-check-input" asp-for="RememberMe" />
                <label class="form-check-label" asp-for="RememberMe">
                    @Html.DisplayNameFor(model => model.RememberMe)
                </label>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-gradient fw-bold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                </button>
            </div>
        </form>

        <div class="text-center mt-3">
            <p class="mb-1">
                Don't have an account?
                <a asp-action="Signup" asp-controller="Account" class="text-decoration-none fw-semibold">Sign up</a>
            </p>
            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary btn-sm mt-2">
                <i class="bi bi-house-door-fill"></i> Back to Home
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
