    @model UserApp
@{
    ViewData["Title"] = "My Profile";
}
<partial name="_PartialHeader"></partial>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- Card Header -->
                <div class="card-header text-center text-white" style="background: linear-gradient(135deg, #007bff, #0056b3);">
                    <h3 class="mb-0 fw-bold">
                        👤 My Profile
                    </h3>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">
                    <div class="d-flex flex-column align-items-center mb-4">
                        <div class="rounded-circle bg-light border shadow-sm d-flex justify-content-center align-items-center"
                             style="width: 120px; height: 120px; font-size: 50px; color: #007bff;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <h4 class="mt-3 text-primary fw-bold">@Model.UserName</h4>
                        <p class="text-muted mb-0">Welcome back to your profile!</p>
                    </div>

                    <hr />

                    <!-- Profile Details Table -->
                    <table class="table table-hover table-striped text-center align-middle shadow-sm">
                        <thead class="table-primary text-dark">
                            <tr>
                                <th><i class="bi bi-person"></i> User Name</th>
                                <th><i class="bi bi-telephone"></i> Phone Number</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-semibold">@Model.UserName</td>
                                <td class="fw-semibold">@Model.PhoneNumber</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light text-center py-3">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-primary me-2 px-4 shadow-sm">
                        ⬅️ Back to Home
                    </a>
                    <a asp-action="SignOut" asp-controller="Account" class="btn btn-outline-danger px-4 shadow-sm">
                        🚪 Logout
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_PartialFooter"></partial>
