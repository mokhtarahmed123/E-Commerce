@model ProductViewModelWithCategory

@{
    ViewData["Title"] = "Add Product";
}

<partial name="_PartialHeader"></partial>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0 rounded-4 product-card">
                <div class="card-header bg-gradient-primary text-white text-center py-4 rounded-top">
                    <h3 class="fw-bold mb-0">
                        <i class="bi bi-plus-circle-fill"></i> Add New Product
                    </h3>
                    <p class="mb-0 text-light fs-6">Fill in the details to add a new product</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="SaveAdd" asp-route-id="@Model.Id" asp-controller="Product" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="alert alert-danger mb-3 shadow-sm"></div>

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="bi bi-box-seam-fill text-primary"></i> Product Name
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg shadow-sm" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Price -->
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-semibold">
                                <i class="bi bi-currency-dollar text-success"></i> Price
                            </label>
                            <input asp-for="Price" class="form-control form-control-lg shadow-sm" placeholder="Enter product price" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <!-- Quantity -->
                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-semibold">
                                <i class="bi bi-stack text-warning"></i> Quantity
                            </label>
                            <input asp-for="Quantity" class="form-control form-control-lg shadow-sm" placeholder="Enter available stock" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <!-- Image Upload -->
                        <div class="mb-3">
                            <label asp-for="UrlImage" class="form-label fw-semibold">
                                <i class="bi bi-image-fill text-info"></i> Product Image
                            </label>
                            <input asp-for="UrlImage" type="file" class="form-control form-control-lg shadow-sm" />
                            <span asp-validation-for="UrlImage" class="text-danger"></span>
                        </div>

                        <!-- Category -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-tags-fill text-danger"></i> Category
                            </label>
                            <select id="CID" name="CID" class="form-select form-select-lg shadow-sm">
                                @foreach (var Category in Model.categories)
                                {
                                    if (Model.Id == Category.Id)
                                    {
                                        <option value="@Category.Id" selected>@Category.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@Category.Id">@Category.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-gradient fw-bold shadow">
                                <i class="bi bi-check-circle-fill"></i> Create Product
                            </button>
                            <a asp-action="AllProduct" class="btn btn-outline-dark fw-semibold shadow-sm">
                                <i class="bi bi-arrow-left-circle"></i> Back to Products
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_PartialFooter"></partial>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
