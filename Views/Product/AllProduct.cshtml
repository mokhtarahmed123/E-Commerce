@model List<Product>

@{
    ViewData["Title"] = "All Products";
}
<partial name="_PartialHeader"></partial>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-bag-fill text-primary"></i> All Products
        </h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Product" asp-action="AddProduct" class="btn btn-gradient shadow-sm">
                <i class="bi bi-plus-circle"></i> Add Product
            </a>
        }
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card shadow-lg border-0 h-100 rounded-4">
                        <!-- Product Image -->
                        <div class="img-container">
                            <img class="card-img-top" src="~/Image/@Url.Content(item.UrlImage)" alt="@item.Name" />
                        </div>

                        <!-- Product Details -->
                        <div class="card-body text-center">
                            <h5 class="fw-bold">@item.Name</h5>
                            <p class="text-muted mb-1">
                                <i class="bi bi-cash-stack text-success"></i> <strong>@Convert.ToDecimal(item.Price).ToString("N2")</strong> EGP
                                
                            </p>
                            <p class="text-secondary">
                                <i class="bi bi-box-seam text-warning"></i> Stock: <strong>@item.Quantity</strong>
                            </p>
                        </div>

                        <!-- Product Actions -->
                        <div class="card-footer bg-light border-0 p-3">
                            <div class="d-flex justify-content-between">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Update" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm shadow-sm w-50 me-1">
                                        <i class="bi bi-pencil-square"></i> Update
                                    </a>
                                    <a asp-action="Delete" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm shadow-sm w-50 ms-1">
                                        <i class="bi bi-trash3-fill"></i> Delete
                                    </a>
                                }
                            </div>
                            <div class="mt-3 text-center">
                                <a asp-route-id="@item.Id" asp-action="CreateOrder" asp-controller="OrderDetail" class="btn btn-gradient shadow-sm w-100">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-5 shadow-sm">
            <i class="bi bi-info-circle-fill"></i> No products available at the moment.
        </div>
    }
</div>

<partial name="_PartialFooter"></partial>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
