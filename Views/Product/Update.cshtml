@model ProductViewModelWithCategory
@{
    ViewData["Title"] = "Update Product";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-gradient text-white text-center rounded-top" style="background: linear-gradient(90deg, #007bff, #0056b3);">
                <h3 class="mb-0">✏️ Update Product</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="SaveEdit" asp-route-id="@Model.Id" asp-controller="Product" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Name -->
                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Price -->
                    <div class="form-floating mb-3">
                        <input asp-for="Price" class="form-control" placeholder="Enter price" />
                        <label asp-for="Price"></label>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <!-- Quantity -->
                    <div class="form-floating mb-3">
                        <input asp-for="Quantity" class="form-control" placeholder="Enter quantity" />
                        <label asp-for="Quantity"></label>
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <!-- Image -->
                    <div class="mb-3">
                        <label asp-for="UrlImage" class="form-label fw-bold"></label>
                        <input asp-for="UrlImage" type="file" class="form-control" />
                        <span asp-validation-for="UrlImage" class="text-danger small"></span>
                    </div>

                    <!-- Category -->
                    <div class="mb-4">
                        <label asp-for="CId" class="form-label fw-bold">Category</label>
                        <select asp-for="CId" class="form-select shadow-sm" asp-items="@(new SelectList(Model.categories, "Id", "Name", Model.CId))">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CId" class="text-danger small"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg shadow">
                            💾 Save Changes
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center bg-light rounded-bottom">
                <a asp-action="AllProduct" class="btn btn-outline-dark px-4">
                    ⬅️ Back to Products
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
