@model OrderWithCustomerAndProduct

@{
    ViewData["Title"] = "Update Order";
}

<partial name="_PartialHeader"></partial>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg rounded-4 border-0 p-4 update-card">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-gradient">
                        <i class="bi bi-pencil-square"></i> Update Your Order
                    </h2>
                    <p class="text-muted">Modify your order details and save the changes below.</p>
                </div>

                <form asp-action="SaveUpdatedOrder" asp-controller="OrderDetail" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
                    <input type="hidden" asp-for="OredrId" />

                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="CustomerPhoneNumber" class="form-control form-control-lg shadow-sm" placeholder="Enter phone number" />
                        <span asp-validation-for="CustomerPhoneNumber" class="text-danger"></span>
                    </div>

                    <!-- Product & Quantity -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Product Name</label>
                            <input asp-for="ProductName" class="form-control form-control-lg shadow-sm" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                            <input asp-for="Quantity" class="form-control form-control-lg shadow-sm" id="quantityInput" type="number" min="1" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Total Price -->
                    <div class="mb-3">
                        <label asp-for="TotalPrice" class="form-label fw-semibold">Total Price (EGP)</label>
                        <input asp-for="TotalPrice" class="form-control form-control-lg shadow-sm" id="totalPriceInput" readonly />
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-gradient px-4 shadow">
                            <i class="bi bi-save2-fill"></i> Save Changes
                        </button>
                        <a asp-action="Index" asp-controller="OrderDetail" class="btn btn-outline-dark shadow">
                            <i class="bi bi-arrow-left-circle"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_PartialFooter"></partial>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const unitPrice = @Model.TotalPrice / @Model.Quantity;
            const quantityInput = document.getElementById("quantityInput");
            const totalPriceInput = document.getElementById("totalPriceInput");

            function updateTotal() {
                const qty = parseInt(quantityInput.value) || 0;
                totalPriceInput.value = (qty * unitPrice).toFixed(2);
            }

            quantityInput.addEventListener("input", updateTotal);
            updateTotal();
        });
    </script>
}
